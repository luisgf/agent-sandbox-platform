# ASP control plane, as the asp-control-plane package installs it.
# Settings go in /etc/asp/server.yaml (mode 0640, group asp-control-plane: it can hold secrets)
# and in the drop-ins in /etc/asp/server.yaml.d/; the file the package leaves there lists the
# usual ones, control-plane/README.md all. Start it with:
#   sudo systemctl enable --now asp-control-plane
#
# This is the packaged unit. scripts/systemd/asp-control-plane.service is the lab
# host's (a user, paths and an IdP of that machine).
[Unit]
Description=ASP control plane
Documentation=https://github.com/luisgf/agent-sandbox-platform/blob/main/control-plane/README.md
After=network-online.target
Wants=network-online.target
# With database_url pointing at a Postgres that may start later (a container, or
# another host) the control plane exits until it answers: retry for ever instead of
# hitting systemd's start limit (5 starts in 10 s).
StartLimitIntervalSec=0

[Service]
Type=simple
# A system user of its own (the package creates it): not a dynamic one, because the key of
# its TLS certificate and the files it is given live in /etc/asp, owned by a name that has to
# stay the same between runs.
User=asp-control-plane
Group=asp-control-plane
# What must survive a reboot (the CA, the OIDC key and the attestation key) lives in this
# directory; /etc/asp/server.yaml says where (ca_cert, ca_key, oidc_key, attest_key).
StateDirectory=asp-control-plane
StateDirectoryMode=0700
# Every setting is in /etc/asp/server.yaml (and its drop-ins): `asp-control-plane --print-config`.
# The service reads the file itself, as its own user: that is why the file belongs to its group.
ExecStart=/usr/bin/asp-control-plane --config /etc/asp/server.yaml
Restart=on-failure
RestartSec=5
# It needs the network and nothing else of the host.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
