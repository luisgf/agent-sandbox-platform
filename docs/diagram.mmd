flowchart TB
  subgraph CLIENT["Cliente"]
    IDE["IDE / orquestador"]
    ASP["CLI asp<br/>sandbox run"]
  end

  subgraph CP["Control plane (Go)"]
    API["HTTP API<br/>sandboxes · nodes · exec<br/>scheduler · node monitor"]
    AUTH["API keys · IdP JWT · mTLS<br/>node identity · cert rotate/revoke"]
    DB[("PostgreSQL<br/>state · events · leases")]
    OIDC["OIDC / JWKS<br/>mint + key prev"]
    ATTEST["Attestation verify<br/>Fence / STONITH"]
    API --> AUTH
    API --> DB
    API --> OIDC
    API --> ATTEST
  end

  subgraph NODE["Nodo × N (uno por servidor)"]
    NA["Node agent (Go)<br/>reconciler · FakeVMM/CH"]
    VMM["Cloud Hypervisor<br/>socket /run/asp/ch-id.sock"]
    NFT["nftables redirect<br/>HTTP/DNS soft|enforce"]
    EP["Egress proxy :8888<br/>DNS sink :5353"]
    TAP["TAP + NAT"]
    HVS["host-vsock<br/>26500 exec · 26501 SSH · 26502 OIDC"]

    subgraph GUEST["microVM guest"]
      PD["pod-daemon (Rust)"]
      SSHP["ssh-agent-vsock<br/>SSH_AUTH_SOCK"]
      WORK["Agent workload"]
      WORK -->|"Exec / files"| PD
      WORK --> SSHP
      SSHP -->|"vsock CID2:26501"| PD
    end

    NA -->|"Start/Stop"| VMM
    VMM --> GUEST
    NA <-->|"vsock / unix dry-run"| PD
    NA --> HVS
    HVS -.->|"SSH agent / OIDC"| GUEST
    GUEST --> TAP
    TAP --> NFT
    NFT --> EP
  end

  IDE -->|"HTTPS + API key"| API
  ASP -->|"HTTPS + API key"| API
  API <-->|"mTLS en los dos sentidos<br/>estado deseado · exec"| NA
