# Template: ASP control-plane (lab IdP on ncc1701d).
# Install (on host): 
#   sudo install -d -m 0755 /etc/asp
#   sudo install -m 0644 scripts/systemd/lab/server.yaml /etc/asp/server.yaml
#   sudo cp scripts/systemd/asp-control-plane.service /etc/systemd/system/
#   # adjust User/paths if clone ≠ /home/ubuntu/src/bots
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now asp-control-plane.service
#
# Settings: /etc/asp/server.yaml (scripts/systemd/lab/server.yaml), which holds no secret.
# Secrets: EnvironmentFile only — never commit ~/.secrets/asp-idp.env; the environment beats the file.
# Docs: docs/lab/ncc1701d.md (the host this template is for), docs/how-to/idp.md
[Unit]
Description=ASP control-plane (Keycloak lab IdP)
Documentation=file:///home/ubuntu/src/bots/docs/lab/ncc1701d.md
After=network-online.target
Wants=network-online.target
# With database_url pointing at a Postgres that may start later (a container, or another
# host) the control plane exits until it answers: retry for ever instead of hitting
# systemd's start limit (5 starts in 10 s). For a Postgres container on this host also add
# After=docker.service and Wants=docker.service (docs/how-to/install-control-plane.md section 1).
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/src/bots
# The IdP settings (ASP_IDP_*) and the secrets (ASP_BOOTSTRAP_API_KEY, ASP_DATABASE_URL) live here,
# mode 0600. Missing file = unit fail (lab expects IdP on).
EnvironmentFile=/home/ubuntu/.secrets/asp-idp.env
# The other settings (listen address, issuer, idle timeout, where the keys are) are in
# /etc/asp/server.yaml. Key material must survive a reboot: systemd creates
# /var/lib/asp-control-plane for User= (see the comments in the YAML).
StateDirectory=asp-control-plane
StateDirectoryMode=0700
ExecStart=/home/ubuntu/src/bots/build/api --config /etc/asp/server.yaml
Restart=on-failure
RestartSec=5
# Bind is loopback-only via listen_addr; do not expose 18112 on 0.0.0.0 without TLS+authz.

[Install]
WantedBy=multi-user.target
