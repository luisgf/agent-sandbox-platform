[Unit]
Description=ASP guest SSH agent (vsock CID2:26501 → unix)
Documentation=https://github.com/luisgf/agent-sandbox-platform
After=network.target
Wants=pod-daemon.service

[Service]
Type=simple
User=sandboxd
Group=sandboxd
WorkingDirectory=/
Environment=ASP_HOST_CID=2
Environment=SSH_AUTH_SOCK=/run/agent-sandbox/ssh-agent.sock
# Lab/dry-run override (unix fallback): set ASP_SSH_AGENT_UPSTREAM=unix:/path in a drop-in.
ExecStart=/usr/local/bin/vsock-ssh-agent-proxy --listen /run/agent-sandbox/ssh-agent.sock --cid 2 --port 26501
Restart=on-failure
RestartSec=1
RuntimeDirectory=agent-sandbox
RuntimeDirectoryMode=0750

# Choice: vsock proxy in guest (not virtiofs). Matches existing host-vsock
# architecture (AF_VSOCK CID 2 ports) and avoids Cloud Hypervisor fs/virtiofs
# config for the agent socket.

[Install]
WantedBy=multi-user.target
